# Toàn bộ project chạy được mà KHÔNG cần tạo ".env.local" — mọi biến dưới đây
# chỉ dùng để override giá trị mặc định đã hardcode sẵn trong code, không phải setup bắt buộc.
# Copy file này thành ".env.local" (git-ignored, per-machine) chỉ khi cần override.

# ─── Optional — override AI Proctoring evidence upload ─────────────────────
# URL endpoint POST tạo violation log trên ASP.NET backend.
# Đi qua Vite proxy (vite.config.js) → https://eduguard-api-gdhg.onrender.com/api/violation-logs
# Mặc định đã hardcode '/api/violation-logs' trong useAiProctoring.ts — chỉ set biến này
# nếu cần trỏ sang backend/đường dẫn khác để test.
# VITE_FASTAPI_EVIDENCE_URL=/api/violation-logs

# ─── Optional ────────────────────────────────────────────────────────────
# Base URL cho các API call thường (/api/...) và SignalR hub (/hubs/...).
# Để trống thì dùng đường dẫn tương đối, đi qua Vite dev proxy tới backend thật
# (xem vite.config.js) — chỉ cần set khi build production hoặc trỏ tới backend khác.
# VITE_API_BASE_URL=

# Giá trị mặc định cho participationId/sessionId/studentId khi test AI proctoring
# độc lập (không qua flow thi thật) — flow thi thật tự truyền ID thật qua
# updateProctoringConfig() nên các biến này không bắt buộc.
# VITE_AI_PARTICIPATION_ID=
# VITE_AI_SESSION_ID=
# VITE_AI_STUDENT_ID=
